  "query": "SELECT c.id AS \"id!\", c.task_id AS \"task_id!\", c.executor_id AS \"executor_id!\",\n               MAX(c.completed_at) AS \"completed_at!: i64\"\n           FROM completions c\n           JOIN tasks t ON t.id = c.task_id\n           WHERE t.project_id = ? AND t.archived_at IS NULL\n           GROUP BY c.task_id",
